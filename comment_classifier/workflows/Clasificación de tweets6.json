    {
      "parameters": {
        "jsCode": "return $input.all().map(item => {\n    // Detectar la ruta real del campo \"content\"\n    let raw =\n        item.json?.content ??\n        item.json?.message?.content ??\n        item.json?.choices?.[0]?.message?.content ??\n        item.json?.choices?.[0]?.message?.message?.content ??\n        undefined;\n\n    if (!raw) {\n        throw new Error(\"No pude encontrar el campo 'content' en este item:\\n\" + JSON.stringify(item.json, null, 2));\n    }\n\n    raw = String(raw).trim();\n\n    // Quitar backticks\n    raw = raw.replace(/```json/g, \"\")\n             .replace(/```/g, \"\")\n             .trim();\n\n    // Reparar comillas simples si la IA las usa\n    if (raw.includes(\"'\") && !raw.includes('\"')) {\n        raw = raw.replace(/'/g, '\"');\n    }\n\n    let parsed;\n    try {\n        parsed = JSON.parse(raw);\n    } catch (e) {\n        throw new Error(\"No pude parsear este item:\\n\" + raw);\n    }\n\n    return { json: parsed };\n});\n"
      },
