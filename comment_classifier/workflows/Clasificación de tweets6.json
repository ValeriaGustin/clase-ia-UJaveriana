      "parameters": {
        "jsCode": "return $input.all().map(item => {\n    const data = item.json;\n\n    const h = data.harmful_content || {};\n    const m = data.misinformation_risk;\n    const p = data.polarization_level;\n\n    // Lista de discursos de odio críticos\n    const hateTypes = [\n        \"odio\",\n        \"discriminación\",\n        \"ataque_personal\",\n        \"acoso\",\n        \"violencia_politica\",\n        \"incitación_violencia\"\n    ];\n\n    // Condición A: Hate speech crítico\n    const isCriticalHate =\n        hateTypes.includes(h.hate_speech_type) &&\n        h.severity === \"critico\";\n\n    // Condición B: Riesgo de desinformación + polarización\n    const isHighRisk =\n        m === \"alto\" &&\n        p === \"alto\";\n\n    // Resultado final\n    const triggerEmail = isCriticalHate || isHighRisk;\n\n    return {\n        json: {\n            ...data,\n            triggerEmail\n        }\n    };\n});\n"
      },
